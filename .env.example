# Notificateur : smtp | github
# Par défaut : github si GH_TOKEN/GITHUB_TOKEN est défini, sinon smtp
# si GMAIL_ADDRESS et GMAIL_APP_PASSWORD sont définis.
# NOTIFY=github

# --- Mode github (recommandé si la machine ne peut pas joindre smtp.gmail.com) ---
# Jeton avec le droit « repo » (par exemple : gh auth token).
# GH_TOKEN=
# GITHUB_REPO=MathGpn/vinted-nba

# --- Mode smtp, ou secrets du workflow GitHub Actions ---
# Utiliser un mot de passe d'application, pas le mot de passe du compte :
# https://myaccount.google.com/apppasswords
# Dans GitHub : Settings → Secrets and variables → Actions
# (GMAIL_ADDRESS, GMAIL_APP_PASSWORD, MAIL_TO).

GMAIL_ADDRESS=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Destinataire, si différent de l'expéditeur.
# MAIL_TO=ton.adresse@gmail.com

# Optionnel
# POLL_INTERVAL=90
# PHILIBERT_QUERY=pokémon 30 ans
# STATE_FILE=seen_products.json
